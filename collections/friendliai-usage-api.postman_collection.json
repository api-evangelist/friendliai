        {
          "id": "3458c1e1-90c8-4969-aabf-be28a981bdcc",
          "name": "Get usage details for the team.",
          "request": {
            "name": "Get usage details for the team.",
            "description": {},
            "url": {
              "path": [
                "v1",
                "team",
                "usage"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "start_time",
                  "value": "<dateTime>",
                  "description": "(Required) RFC 3339 timestamp in UTC. Must fall on a 5-minute boundary (e.g., 2026-01-01T10:05:00Z). It must be no earlier than one year ago. When `bucket_width=1h`, it must align to an hour boundary (e.g., `10:00:00Z`); when `bucket_width=1d`, it must align to a day boundary (e.g., `00:00:00Z`)."
                },
                {
                  "disabled": false,
                  "key": "end_time",
                  "value": "<dateTime>",
                  "description": "(Required) RFC 3339 timestamp in UTC. Must fall on a 5-minute boundary (e.g., 2026-01-01T10:05:00Z), and its minute value must match `start_time`'s. It must obey the same hour/day alignment as `start_time` when `bucket_width=1h` or `1d`."
                },
                {
                  "disabled": false,
                  "key": "bucket_width",
                  "value": "<string>",
                  "description": "Width of each time bucket in response. Currently `1d`, `1h`, and `5m` are supported, default to `1d`."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>",
                  "description": "Specifies the number of buckets to return.\n- `bucket_width=1d`: default limit = 7, max limit = 31\n- `bucket_width=1h`: default limit = 24, max limit = 168\n- `bucket_width=5m`: default limit = 12, max limit = 288"
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "<string>",
                  "description": "A cursor for use in pagination. Corresponding to the `next_page` field from the previous response."
                },
                {
                  "disabled": false,
                  "key": "group_by",
                  "value": "<string>",
                  "description": "Group the usage by the specified fields. Support fields include `model`, `product_type`, `user_id` and any combination of them."
                },
                {
                  "disabled": false,
                  "key": "group_by",
                  "value": "<string>",
                  "description": "Group the usage by the specified fields. Support fields include `model`, `product_type`, `user_id` and any combination of them."
                },
                {
                  "disabled": false,
                  "key": "models",
                  "value": "<string>",
                  "description": "Return only usage for the listed Model APIs and Dedicated Endpoints. Values are model IDs, endpoint IDs, or a mix."
                },
                {
                  "disabled": false,
                  "key": "models",
                  "value": "<string>",
                  "description": "Return only usage for the listed Model APIs and Dedicated Endpoints. Values are model IDs, endpoint IDs, or a mix."
                },
                {
                  "disabled": false,
                  "key": "user_ids",
                  "value": "<string>",
                  "description": "Return only usage for these users."
                },
                {
                  "disabled": false,
                  "key": "user_ids",
                  "value": "<string>",
                  "description": "Return only usage for these users."
                },
                {
                  "disabled": false,
                  "key": "product_types",
                  "value": "<string>",
                  "description": "Return only usage for the specified product types. Supported fields include `model_apis`, `dedicated_endpoints` and any combination of them."
                },
                {
                  "disabled": false,
                  "key": "product_types",
                  "value": "<string>",
                  "description": "Return only usage for the specified product types. Supported fields include `model_apis`, `dedicated_endpoints` and any combination of them."
                },
                {
                  "disabled": false,
                  "key": "gpu_types",
                  "value": "<string>",
                  "description": "Return only usage for the specified GPU types. When this filter is applied, product_types is implicitly set to `dedicated_endpoints`."
                },
                {
                  "disabled": false,
                  "key": "gpu_types",
                  "value": "<string>",
                  "description": "Return only usage for the specified GPU types. When this filter is applied, product_types is implicitly set to `dedicated_endpoints`."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
